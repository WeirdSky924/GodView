# ======================== 应用配置 ========================
APP_NAME=Godview
APP_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO

# ======================== 数据库配置 ========================
# PostgreSQL 连接 URL（格式：postgresql+asyncpg://用户名:密码@主机:端口/数据库名）
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/godview

# NebulaGraph 图数据库
NEBULA_HOST=127.0.0.1
NEBULA_PORT=9669
NEBULA_USER=root
NEBULA_PASSWORD=nebula

# Qdrant 向量数据库
QDRANT_URL=http://localhost:6333

# ======================== Embedding 配置 ========================
# 三种模式可选，选其一即可：
#
# 模式一：OpenAI API（在线，需要 API Key）
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=sk-your-openai-key
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_DIMENSION=1536
#
# 模式二：Sentence-Transformers（本地，首次自动下载模型）
# EMBEDDING_PROVIDER=sentence_transformers
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_DIMENSION=384
#
# 模式三：Ollama（本地自部署服务）
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=http://localhost:11434
# EMBEDDING_DIMENSION=768

# 默认启用 Sentence-Transformers 模式（最省事）
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSION=384

# ======================== LLM 配置 ========================
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ======================== 导演系统配置 ========================
MAX_TURNS_THRESHOLD=5
TARGET_WORD_COUNT_PER_INTENT=200
MIN_CHAPTER_WORD_COUNT=2000