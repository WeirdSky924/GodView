# 应用配置
APP_NAME=Godview
APP_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO

# 数据库配置
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/godview

# NebulaGraph 配置
NEBULA_HOST=127.0.0.1
NEBULA_PORT=9669
NEBULA_USER=root
NEBULA_PASSWORD=nebula

# Qdrant 配置
QDRANT_URL=http://localhost:6333

# LLM 配置 (以 OpenAI 为例)
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Embedding 配置
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# 导演系统配置
MAX_TURNS_THRESHOLD=5
TARGET_WORD_COUNT_PER_INTENT=200
MIN_CHAPTER_WORD_COUNT=2000