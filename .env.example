# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database - PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/godview_db
ASYNC_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/godview_db

# Database - NebulaGraph
NEBULA_HOST=127.0.0.1
NEBULA_PORT=9669
NEBULA_USER=root
NEBULA_PASSWORD=nebula

# Vector Database - Qdrant (if using separately)
QDRANT_URL=http://localhost:6333

# LangSmith (Optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=godview

# Application Settings
APP_ENV=development
LOG_LEVEL=DEBUG

# Model Settings
DEFAULT_MODEL=claude-sonnet-4-6-20250929
ROUTER_ENABLED=false
