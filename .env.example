# ======================== 应用配置 ========================
APP_NAME=Godview
APP_VERSION=1.3.108
DEBUG=True
LOG_LEVEL=INFO

# ======================== 服务器配置（前后端分离时需要修改）========================
# 后端 API 基础 URL
API_BASE_URL=http://localhost:8000
# WebSocket 基础 URL
WS_BASE_URL=ws://localhost:8000
# 前端 URL（用于 CORS 配置）
FRONTEND_URL=http://localhost:5173

# ======================== 数据库配置 ========================
# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/godview

# Redis（运行中操作锁、租约、幂等缓存和事件缓存；Postgres 仍是事实源）
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
OPERATION_LEASE_TTL_SECONDS=60
OPERATION_CACHE_TTL_SECONDS=86400
WORKFLOW_EVENT_RETENTION_SECONDS=604800

# 业务级执行 Trace（默认不保存完整 prompt）
TRACE_ENABLED=true
TRACE_CAPTURE_PROMPTS=false
TRACE_CAPTURE_LLM_RESPONSES=true
TRACE_MAX_ARTIFACT_CHARS=50000
TRACE_REDACT_SECRETS=true

# NebulaGraph 图数据库
NEBULA_HOST=127.0.0.1
NEBULA_PORT=9669
NEBULA_USER=root
NEBULA_PASSWORD=nebula

# 关系图投影（Postgres outbox，NebulaGraph 为非阻塞投影层）
GRAPH_PROJECTION_ENABLED=false
GRAPH_PROJECTION_OUTBOX_ENABLED=true
GRAPH_PROJECTION_RETRY_LIMIT=5
GRAPH_PROJECTION_BATCH_SIZE=100
GRAPH_PROJECTION_WORKER_ENABLED=false
GRAPH_PROJECTION_POLL_INTERVAL_SECONDS=2.0
GRAPH_PROJECTION_LEASE_SECONDS=60
GRAPH_PROJECTION_RETRY_BASE_SECONDS=5

# Qdrant 向量数据库
QDRANT_URL=http://localhost:6333

# ======================== Embedding 配置 ========================
# 当前使用的 Provider (openai / sentence_transformers / ollama)
EMBEDDING_PROVIDER=sentence_transformers

# ===== OpenAI Embedding 配置 =====
EMBEDDING_OPENAI_MODEL=text-embedding-3-small
EMBEDDING_OPENAI_API_KEY=your-openai-api-key-here
EMBEDDING_OPENAI_BASE_URL=https://api.openai.com/v1

# ===== Sentence-Transformers 配置 =====
EMBEDDING_ST_MODEL=all-MiniLM-L6-v2
# 模型存储路径，留空使用默认 ~/.cache/huggingface/hub
EMBEDDING_ST_CACHE_FOLDER=

# ===== Ollama Embedding 配置 =====
EMBEDDING_OLLAMA_MODEL=nomic-embed-text
EMBEDDING_OLLAMA_BASE_URL=http://localhost:11434

# ======================== LLM 配置 ========================
# 当前使用的 Provider (openai / anthropic / zhipu / qwen / deepseek / moonshot / baichuan / yi / minimax / openrouter)
LLM_PROVIDER=openai

# ===== OpenAI 协议配置 =====
LLM_OPENAI_MODEL=gpt-4o
LLM_OPENAI_API_KEY=your-openai-api-key-here
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_OPENAI_TEMPERATURE=0.7
LLM_OPENAI_MAX_TOKENS=4096

# ===== Anthropic 协议配置 =====
LLM_ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_ANTHROPIC_TEMPERATURE=0.7
LLM_ANTHROPIC_MAX_TOKENS=4096

# ===== 智谱 AI 配置 =====
LLM_ZHIPU_MODEL=glm-4-plus
LLM_ZHIPU_API_KEY=your-zhipu-api-key-here
LLM_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_ZHIPU_TEMPERATURE=0.7
LLM_ZHIPU_MAX_TOKENS=4096

# ===== 通义千问配置 =====
LLM_QWEN_MODEL=qwen-max
LLM_QWEN_API_KEY=your-qwen-api-key-here
LLM_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_QWEN_TEMPERATURE=0.7
LLM_QWEN_MAX_TOKENS=4096

# ===== DeepSeek 配置 =====
LLM_DEEPSEEK_MODEL=deepseek-chat
LLM_DEEPSEEK_API_KEY=your-deepseek-api-key-here
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_DEEPSEEK_TEMPERATURE=0.7
LLM_DEEPSEEK_MAX_TOKENS=4096

# ===== Moonshot (Kimi) 配置 =====
LLM_MOONSHOT_MODEL=moonshot-v1-8k
LLM_MOONSHOT_API_KEY=your-moonshot-api-key-here
LLM_MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
LLM_MOONSHOT_TEMPERATURE=0.7
LLM_MOONSHOT_MAX_TOKENS=4096

# ===== 百川配置 =====
LLM_BAICHUAN_MODEL=Baichuan4
LLM_BAICHUAN_API_KEY=your-baichuan-api-key-here
LLM_BAICHUAN_BASE_URL=https://api.baichuan-ai.com/v1
LLM_BAICHUAN_TEMPERATURE=0.7
LLM_BAICHUAN_MAX_TOKENS=4096

# ===== 零一万物配置 =====
LLM_YI_MODEL=yi-large
LLM_YI_API_KEY=your-yi-api-key-here
LLM_YI_BASE_URL=https://api.lingyiwanwu.com/v1
LLM_YI_TEMPERATURE=0.7
LLM_YI_MAX_TOKENS=4096

# ===== MiniMax 配置 =====
LLM_MINIMAX_MODEL=abab6.5-chat
LLM_MINIMAX_API_KEY=your-minimax-api-key-here
LLM_MINIMAX_BASE_URL=https://api.minimax.chat/v1
LLM_MINIMAX_TEMPERATURE=0.7
LLM_MINIMAX_MAX_TOKENS=4096

# ===== OpenRouter 配置 =====
LLM_OPENROUTER_MODEL=anthropic/claude-sonnet-4
LLM_OPENROUTER_API_KEY=your-openrouter-api-key-here
LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_OPENROUTER_TEMPERATURE=0.7
LLM_OPENROUTER_MAX_TOKENS=4096

# ======================== 导演系统配置 ========================
MAX_TURNS_THRESHOLD=5
TARGET_WORD_COUNT_PER_INTENT=200
MIN_CHAPTER_WORD_COUNT=2000
